{
  "schemaVersion": 1,
  "id": "keybindbundles",
  "version": "${version}",
  "name": "KeyBind Bundles",
  "description": "Unofficial Fabric port of KeyBind Bundles. Bundle keybinds into radial menus.",
  "authors": [
    "Matyrobbrt",
    "ashleywr (Fabric port)"
  ],
  "contact": {
    "homepage": "https://github.com/MatyrobbrtMods/KeyBindBundles",
    "sources": "https://github.com/ashleywr/KeyBindBundlesFabric"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.matyrobbrt.keybindbundles.ModKeyBindBundles"
    ],
    "modmenu": [
      "com.matyrobbrt.keybindbundles.compat.ModMenuIntegration"
    ]
  },
  "accessWidener": "keybindbundles.accesswidener",
  "mixins": [
    "keybindbundles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "cloth-config2": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "controlling": "*",
    "modmenu": "*"
  }
}
